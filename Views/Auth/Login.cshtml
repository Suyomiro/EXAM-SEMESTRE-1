@model Brasil_Burger_Client.Models.ViewModels.AuthViewModel
@{
    ViewData["Title"] = "Compte";
}

<div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-orange-500/10 via-black to-pink-500/10 px-4">
    <div class="w-full max-w-md bg-white/5 border border-white/10 rounded-3xl p-8 shadow-xl space-y-6">
        <div class="text-center space-y-2">
            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-orange-500 to-pink-500 rounded-2xl text-3xl">🍔</div>
            <h1 class="text-2xl font-semibold">Brasil Burger</h1>
            <p class="text-white/60">Connectez-vous ou créez un compte</p>
        </div>

        <form method="post" asp-action="Login" class="space-y-4">
            <input type="hidden" name="IsSignup" value="@(Model.IsSignup == true ? "true" : "false")" />

            @if (Model.IsSignup == true)
            {
                <div class="grid grid-cols-2 gap-3">
                    <input name="Prenom" value="@Model.Prenom" placeholder="Prénom" class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500" required />
                    <input name="Nom" value="@Model.Nom" placeholder="Nom" class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500" required />
                </div>
                <input name="Telephone" value="@Model.Telephone" placeholder="Téléphone" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500" required />
            }

            <input name="Email" value="@Model.Email" type="email" placeholder="Email" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500" required />
            <input name="Password" value="@Model.Password" type="password" placeholder="Mot de passe" class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500" required />

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="p-3 rounded-xl bg-red-500/20 border border-red-500/40 text-sm text-red-100">
                    @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            }

            <button type="submit" class="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-pink-500 font-semibold hover:opacity-90 transition">
                @(Model.IsSignup == true ? "Créer mon compte" : "Se connecter")
            </button>
        </form>

        <form method="get" asp-action="Login" class="text-center text-sm text-white/70">
            <input type="hidden" name="IsSignup" value="@((Model.IsSignup == true) ? "false" : "true")" />
            <button class="underline">
                @(Model.IsSignup == true ? "Déjà un compte ? Connexion" : "Pas encore de compte ? Inscription")
            </button>
        </form>
    </div>
</div>





