@model Brasil_Burger_Client.Models.ViewModels.CatalogViewModel
@{
    ViewData["Title"] = "Catalogue";
}

<div class="max-w-7xl mx-auto px-4 py-10 space-y-8">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 bg-gradient-to-br from-orange-500 to-pink-500 rounded-2xl flex items-center justify-center text-3xl">🍔</div>
            <div>
                <h1 class="text-2xl font-semibold">Brasil Burger</h1>
                <p class="text-white/60">Menus, burgers & compléments</p>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <a class="px-4 py-2 rounded-xl border border-white/10 hover:border-white/30 transition" asp-controller="Cart" asp-action="Index">Panier</a>
            <a class="px-4 py-2 rounded-xl border border-white/10 hover:border-white/30 transition" asp-controller="Orders" asp-action="Index">Mes commandes</a>
        </div>
    </div>

    <form method="get" class="grid md:grid-cols-3 gap-3 bg-white/5 border border-white/10 rounded-2xl p-4">
        <input name="search" value="@Model.Search" placeholder="Rechercher un produit..." class="md:col-span-2 px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500" />
        <select name="category" class="px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:outline-none focus:ring-2 focus:ring-orange-500">
            <option value="all" selected="@("all" == Model.Category)">Toutes les catégories</option>
            <option value="boissons" selected="@("boissons" == Model.Category)">Boissons</option>
            <option value="accompagnements" selected="@("accompagnements" == Model.Category)">Accompagnements</option>
            <option value="desserts" selected="@("desserts" == Model.Category)">Desserts</option>
        </select>
        <button type="submit" class="px-4 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-pink-500 font-semibold hover:opacity-90 transition">Filtrer</button>
    </form>

    @if (Model.Burgers.Any())
    {
        <section class="space-y-4">
            <div class="flex items-center gap-3">
                <h2 class="text-xl font-semibold">🍔 Nos Burgers</h2>
                <span class="px-3 py-1 rounded-full bg-white/10 text-sm">@Model.Burgers.Count() produits</span>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var burger in Model.Burgers)
                {
                    <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden flex flex-col">
                        <img src="@burger.Image" alt="@burger.Nom" class="h-44 w-full object-cover" />
                        <div class="p-4 flex-1 flex flex-col gap-3">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h3 class="text-lg font-semibold">@burger.Nom</h3>
                                    <p class="text-sm text-white/60">Burger</p>
                                </div>
                                <span class="text-orange-400 font-semibold">@burger.Prix.ToString("N0") FCFA</span>
                            </div>
                            <form method="post" asp-action="AddToCart">
                                <input type="hidden" name="type" value="burger" />
                                <input type="hidden" name="id" value="@burger.Id" />
                                <button class="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-pink-500 font-semibold hover:opacity-90 transition">Ajouter au panier</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.Menus.Any())
    {
        <section class="space-y-4">
            <div class="flex items-center gap-3">
                <h2 class="text-xl font-semibold">🍱 Nos Menus</h2>
                <span class="px-3 py-1 rounded-full bg-white/10 text-sm">@Model.Menus.Count() menus</span>
            </div>
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var menu in Model.Menus)
                {
                    var price = (menu.Burger?.Prix ?? 0) + (menu.Boisson?.Prix ?? 0) + (menu.Frite?.Prix ?? 0);
                    <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden flex flex-col">
                        <img src="@menu.Image" alt="@menu.Nom" class="h-44 w-full object-cover" />
                        <div class="p-4 flex-1 flex flex-col gap-3">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h3 class="text-lg font-semibold">@menu.Nom</h3>
                                    <p class="text-sm text-white/60">Menu complet</p>
                                </div>
                                <span class="text-orange-400 font-semibold">@price.ToString("N0") FCFA</span>
                            </div>
                            <form method="post" asp-action="AddToCart">
                                <input type="hidden" name="type" value="menu" />
                                <input type="hidden" name="id" value="@menu.Id" />
                                <button class="w-full px-4 py-3 rounded-xl bg-gradient-to-r from-orange-500 to-pink-500 font-semibold hover:opacity-90 transition">Ajouter au panier</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (Model.Complements.Any())
    {
        <section class="space-y-4">
            <div class="flex items-center gap-3">
                <h2 class="text-xl font-semibold">🍟 Compléments</h2>
                <span class="px-3 py-1 rounded-full bg-white/10 text-sm">@Model.Complements.Count() produits</span>
            </div>
            <div class="grid md:grid-cols-3 lg:grid-cols-4 gap-6">
                @foreach (var c in Model.Complements)
                {
                    <div class="bg-white/5 border border-white/10 rounded-2xl overflow-hidden flex flex-col">
                        <img src="@c.Image" alt="@c.Nom" class="h-36 w-full object-cover" />
                        <div class="p-4 flex-1 flex flex-col gap-3">
                            <div class="flex items-start justify-between gap-2">
                                <div>
                                    <h3 class="text-lg font-semibold">@c.Nom</h3>
                                    <p class="text-sm text-white/60 capitalize">@c.Type</p>
                                </div>
                                <span class="text-orange-400 font-semibold">@c.Prix.ToString("N0") FCFA</span>
                            </div>
                            <form method="post" asp-action="AddToCart">
                                <input type="hidden" name="type" value="complement" />
                                <input type="hidden" name="id" value="@c.Id" />
                                <button class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/10 hover:border-orange-400 transition">Ajouter</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    @if (!Model.Burgers.Any() && !Model.Menus.Any() && !Model.Complements.Any())
    {
        <div class="text-center py-20 text-white/70">
            <div class="text-5xl mb-4">🔍</div>
            <p>Aucun produit trouvé, essayez d’autres filtres.</p>
        </div>
    }
</div>





