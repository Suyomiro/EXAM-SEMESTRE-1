@model Brasil_Burger_Client.Models.ViewModels.OrderListViewModel
@{
    ViewData["Title"] = "Mes commandes";
}

<div class="max-w-6xl mx-auto px-4 py-10 space-y-6">
    <div class="flex items-center gap-3">
        <a asp-controller="Catalog" asp-action="Index" class="px-3 py-2 rounded-xl bg-white/5 border border-white/10 hover:border-white/30 transition">← Catalogue</a>
        <h1 class="text-2xl font-semibold">Mes commandes</h1>
        <span class="px-3 py-1 rounded-full bg-white/10 text-sm">@Model.Orders.Count() commande(s)</span>
    </div>

    @if (!Model.Orders.Any())
    {
        <div class="text-center py-16 text-white/70">
            <div class="text-5xl mb-4">📦</div>
            <p>Aucune commande pour le moment.</p>
        </div>
    }
    else
    {
        <div class="space-y-4">
            @foreach (var order in Model.Orders)
            {
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 space-y-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <div class="flex items-center gap-3">
                                <h3 class="text-lg font-semibold">Commande #@order.Id</h3>
                                <span class="px-3 py-1 rounded-full text-sm bg-white/10">@order.Etat</span>
                            </div>
                            <p class="text-sm text-white/60">@order.DateCommande.ToLocalTime().ToString("dd MMM yyyy HH:mm") - @order.Type</p>
                            @if (order.Zone != null)
                            {
                                <p class="text-sm text-white/60">Zone: @order.Zone.Nom</p>
                            }
                        </div>
                        <div class="text-right">
                            <p class="text-2xl text-orange-400 font-semibold">@order.Total.ToString("N0") FCFA</p>
                            @if (order.Paiement != null)
                            {
                                <p class="text-sm text-white/60">Paiement: @order.Paiement.Methode</p>
                            }
                        </div>
                    </div>

                    <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                        <h4 class="font-semibold mb-2">Articles</h4>
                        <ul class="space-y-1 text-sm text-white/80">
                            @foreach (var line in order.Lignes)
                            {
                                var name = line.Burger?.Nom ?? line.Menu?.Nom ?? line.Complement?.Nom ?? "Article";
                                <li class="flex justify-between">
                                    <span>@line.Quantite x @name</span>
                                    <span>@((line.PrixUnitaire * line.Quantite).ToString("N0")) FCFA</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
    }
</div>





