{% extends 'manager/layout.html.twig' %}

{% block title %}Livreurs - Brasil Burger{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold mb-2">Gestion des livreurs</h1>
            <p class="text-slate-500">Voir et ajouter des livreurs</p>
        </div>
    </div>

    <div class="bg-white border border-slate-200 rounded-xl p-6">
        <h3 class="font-semibold mb-4">Liste des livreurs</h3>
        {% if livreurs is not empty %}
            <div class="flow-root">
                <ul class="divide-y divide-slate-100">
                    {% for l in livreurs %}
                        <li class="py-3 flex items-center justify-between">
                            <div>
                                <div class="font-medium">{{ l.nom }} {{ l.prenom }}</div>
                                <div class="text-sm text-slate-500">{{ l.telephone }}</div>
                            </div>
                            <div class="flex items-center gap-2">
                                <a href="{{ path('livreurs_edit', {id: l.id}) }}" class="px-3 py-2 rounded-lg text-sm bg-slate-100 hover:bg-slate-200">Modifier</a>
                                <form method="post" action="{{ path('livreurs_delete', {id: l.id}) }}" onsubmit="return confirm('Supprimer ce livreur ?');">
                                    <button type="submit" class="px-3 py-2 rounded-lg text-sm text-red-600 hover:bg-red-50">Supprimer</button>
                                </form>
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <p class="text-slate-500">Aucun livreur ajouté pour le moment.</p>
        {% endif %}
    </div>

    <div class="bg-gradient-to-br from-emerald-50 to-sky-50 border border-slate-200 rounded-xl p-6">
        <h3 class="mb-4 font-semibold">Ajouter un livreur</h3>
        <form method="post" action="{{ path('livreurs_create') }}" class="space-y-4">
            <div class="grid md:grid-cols-3 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Nom</label>
                    <input type="text" name="nom" required placeholder="Nom"
                           class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Prénom</label>
                    <input type="text" name="prenom" required placeholder="Prénom"
                           class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Téléphone</label>
                    <input type="text" name="telephone" required placeholder="77xxxxxxx"
                           class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
            </div>
            <button type="submit"
                    class="inline-flex items-center px-4 py-2 rounded-lg bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600">
                Ajouter le livreur
            </button>
        </form>
    </div>
</div>
{% endblock %}
