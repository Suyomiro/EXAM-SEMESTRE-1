{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-slate-100 flex">
    <aside class="w-64 bg-white border-r border-slate-200 hidden lg:flex flex-col lg:fixed lg:top-0 lg:left-0 lg:h-screen">
        <div class="p-6 border-b border-slate-200">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-emerald-500 rounded-xl flex items-center justify-center">
                    <span class="text-xl">🍔</span>
                </div>
                <div>
                    <h2 class="text-emerald-600 font-semibold">Brasil Burger</h2>
                    <p class="text-xs text-slate-500">Gestionnaire</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 p-4 space-y-2">
            {% set current = app.request.attributes.get('_route') %}
            <a href="{{ path('dashboard_index') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium {{ current starts with 'dashboard_' ? 'bg-emerald-500 text-white shadow-lg' : 'hover:bg-slate-100 text-slate-800' }}">
                <span>📊</span>
                <span>Tableau de bord</span>
            </a>
            <a href="{{ path('products_index') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium {{ current starts with 'products_' ? 'bg-emerald-500 text-white shadow-lg' : 'hover:bg-slate-100 text-slate-800' }}">
                <span>📦</span>
                <span>Produits</span>
            </a>
            <a href="{{ path('orders_index') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium {{ current starts with 'orders_' ? 'bg-emerald-500 text-white shadow-lg' : 'hover:bg-slate-100 text-slate-800' }}">
                <span>🧾</span>
                <span>Commandes</span>
            </a>
            <a href="{{ path('zones_index') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium {{ current starts with 'zones_' ? 'bg-emerald-500 text-white shadow-lg' : 'hover:bg-slate-100 text-slate-800' }}">
                <span>📍</span>
                <span>Zones de livraison</span>
            </a>
            <a href="{{ path('livreurs_index') }}"
               class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium {{ current starts with 'livreurs_' ? 'bg-emerald-500 text-white shadow-lg' : 'hover:bg-slate-100 text-slate-800' }}">
                <span>🚚</span>
                <span>Livreurs</span>
            </a>
        </nav>
        <div class="p-4 border-t border-slate-200">
            <form method="post" action="{{ path('manager_logout') }}">
                <button type="submit"
                        class="w-full flex items-center gap-2 px-4 py-2 rounded-lg text-sm text-red-600 hover:bg-red-50">
                    <span>🚪</span>
                    <span>Déconnexion</span>
                </button>
            </form>
        </div>
    </aside>

    <main class="flex-1 min-w-0 lg:ml-64">
        <header class="lg:hidden sticky top-0 z-20 bg-white border-b border-slate-200 px-4 py-4 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 bg-emerald-500 rounded-lg flex items-center justify-center">
                    <span class="text-lg">🍔</span>
                </div>
                <span class="font-medium">Brasil Burger</span>
            </div>
        </header>

        <div class="max-w-6xl mx-auto py-8 px-4 lg:px-8">
            {# Flash messages disabled per user request #}

            {% block content %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}


