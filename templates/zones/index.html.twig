{% extends 'manager/layout.html.twig' %}

{% block title %}Zones de livraison - Brasil Burger{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-semibold mb-2">Gestion des zones de livraison</h1>
            <p class="text-slate-500">Gérer les zones et les tarifs de livraison</p>
        </div>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-white border border-slate-200 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="text-emerald-500 text-xl">📍</span>
                <h3 class="font-semibold">Total zones</h3>
            </div>
            <p class="text-3xl font-semibold text-emerald-600">{{ zones|length }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="text-xl">🏘️</span>
                <h3 class="font-semibold">Quartiers couverts</h3>
            </div>
            <p class="text-3xl font-semibold text-emerald-600">{{ totalQuartiers }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-2">
                <span class="text-xl">💰</span>
                <h3 class="font-semibold">Prix moyen</h3>
            </div>
            <p class="text-3xl font-semibold text-emerald-600">
                {{ averagePrice|number_format(0, '', ' ') }} FCFA
            </p>
        </div>
    </div>

    <div class="grid md:grid-cols-2 gap-6">
        {% for zone in zones %}
            <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-lg transition">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-start gap-3">
                        <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center">
                            <span class="text-xl text-emerald-500">📍</span>
                        </div>
                        <div>
                            <h3 class="font-semibold mb-1">{{ zone.name }}</h3>
                            <p class="text-2xl font-semibold text-emerald-600">
                                {{ zone.price|number_format(0, '', ' ') }} FCFA
                            </p>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <form method="post" action="{{ path('zones_delete', {id: zone.id}) }}">
                            <button type="submit" class="px-3 py-2 rounded-lg text-sm text-red-600 hover:bg-red-50">
                                Supprimer
                            </button>
                        </form>
                    </div>
                </div>

                <div>
                    <h4 class="mb-2 text-sm text-slate-500">Quartiers couverts</h4>
                    <div class="flex flex-wrap gap-2">
                        {% for quartier in zone.quartiers %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-slate-100 text-slate-700">
                                {{ quartier }}
                            </span>
                        {% endfor %}
                    </div>
                </div>

                <div class="mt-4 pt-4 border-t border-slate-200 flex items-center justify-between text-sm">
                    <span class="text-slate-500">
                        {{ zone.quartiers|length }} quartier{% if zone.quartiers|length > 1 %}s{% endif %}
                    </span>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-emerald-100 text-emerald-700">
                        Active
                    </span>
                </div>
            </div>
        {% else %}
            <p class="text-slate-500">Aucune zone définie.</p>
        {% endfor %}
    </div>

    <div class="bg-gradient-to-br from-emerald-50 to-sky-50 border border-slate-200 rounded-xl p-6">
        <h3 class="mb-4 font-semibold">Nouvelle zone de livraison</h3>
        <form method="post" action="{{ path('zones_create') }}" class="space-y-4">
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-1">Nom de la zone</label>
                    <input type="text" name="name" required placeholder="Ex: Plateau"
                           class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1">Prix de livraison (FCFA)</label>
                    <input type="number" name="price" required placeholder="1000"
                           class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1">
                    Quartiers (séparés par des virgules)
                </label>
                <textarea name="quartiers" rows="3" placeholder="Plateau Centre, Fann, Mermoz"
                          class="w-full px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
                <p class="text-xs text-slate-500 mt-1">Séparez les quartiers par des virgules</p>
            </div>
            <button type="submit"
                    class="inline-flex items-center px-4 py-2 rounded-lg bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600">
                Créer la zone
            </button>
        </form>
    </div>
</div>
{% endblock %}


