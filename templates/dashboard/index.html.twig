{% extends 'manager/layout.html.twig' %}

{% block title %}Tableau de bord - Brasil Burger{% endblock %}

{% block content %}
<div class="space-y-8">
    <div>
        <h1 class="text-2xl font-semibold mb-2">Tableau de bord</h1>
        <p class="text-slate-500">Vue d'ensemble de votre activité du jour</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Commandes en cours</p>
            <p class="text-2xl font-semibold text-amber-500">{{ ordersInProgress }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Commandes validées</p>
            <p class="text-2xl font-semibold text-sky-500">{{ ordersValidated }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Recettes du jour</p>
            <p class="text-2xl font-semibold text-emerald-600">
                {{ dailyRevenue|number_format(0, '', ' ') }} FCFA
            </p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Commandes annulées</p>
            <p class="text-2xl font-semibold text-amber-500">{{ ordersCancelled }}</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Commandes terminées</p>
            <p class="text-2xl font-semibold text-emerald-600">{{ ordersCompleted }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Total commandes</p>
            <p class="text-2xl font-semibold text-slate-900">{{ todayOrdersCount }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Produits actifs</p>
            <p class="text-2xl font-semibold text-sky-500">{{ productsCount }}</p>
        </div>
        <div class="bg-white border border-slate-200 rounded-xl p-4">
            <p class="text-sm text-slate-500 mb-1">Clients du jour</p>
            <p class="text-2xl font-semibold text-violet-500">{{ clientsToday }}</p>
        </div>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
        <div class="bg-white border border-slate-200 rounded-xl p-6">
            <h2 class="mb-6 text-lg font-semibold">🏆 Produits les plus vendus du jour</h2>
            {% if topItems is empty %}
                <div class="text-center py-8 text-slate-400">
                    Aucune vente aujourd'hui
                </div>
            {% else %}
                <div class="space-y-3">
                    {% for item in topItems %}
                        <div class="flex items-center justify-between p-3 bg-slate-50 rounded-lg">
                            <span>{{ item.name }}</span>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-emerald-100 text-emerald-700">
                                {{ item.count }} vendus
                            </span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="bg-white border border-slate-200 rounded-xl p-6">
            <h2 class="mb-6 text-lg font-semibold">📦 Commandes récentes</h2>
            <div class="space-y-3">
                {% for order in recentOrders %}
                    <div class="p-3 bg-slate-50 rounded-lg">
                        <div class="flex items-start justify-between mb-1">
                            <div>
                                <span class="font-medium">#{{ order.id }}</span>
                                <p class="text-sm text-slate-500">{{ order.customer.name }}</p>
                            </div>
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs
                                {% if order.status == 'en-cours' %}bg-amber-100 text-amber-700
                                {% elseif order.status == 'validée' %}bg-sky-100 text-sky-700
                                {% elseif order.status == 'terminée' %}bg-emerald-100 text-emerald-700
                                {% else %}bg-red-100 text-red-700{% endif %}">
                                {{ order.status }}
                            </span>
                        </div>
                        <div class="flex items-center justify-between text-sm text-slate-600">
                            <span class="capitalize">{{ order.type }}</span>
                            <span class="text-emerald-600 font-medium">
                                {{ order.total|number_format(0, '', ' ') }} FCFA
                            </span>
                        </div>
                    </div>
                {% else %}
                    <p class="text-slate-400 text-sm">Aucune commande pour le moment.</p>
                {% endfor %}
            </div>
        </div>
    </div>

</div>
{% endblock %}


