{% extends 'manager/layout.html.twig' %}

{% block title %}Gestion des commandes - Brasil Burger{% endblock %}

{% block content %}
<div class="space-y-6">
    <div>
        <h1 class="text-2xl font-semibold mb-2">Gestion des commandes</h1>
        <p class="text-slate-500">Gérer et suivre toutes les commandes</p>
    </div>

    <form method="get" class="space-y-4">
        <div class="flex flex-col md:flex-row gap-4">
            <input type="text" name="q" value="{{ search }}" placeholder="Rechercher une commande ou un client..."
                   class="flex-1 px-3 py-2 rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500">
            <div class="flex gap-2 items-center">
                <span class="text-sm text-slate-500">Statut:</span>
                {% for s in ['all', 'en-cours', 'validée', 'terminée', 'annulée'] %}
                    <button name="status" value="{{ s }}"
                            class="px-3 py-2 rounded-lg text-sm {{ statusFilter == s ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-700' }}">
                        {{ s == 'all' ? 'Tous' : s }}
                    </button>
                {% endfor %}
            </div>
            <div class="flex gap-2 items-center">
                <span class="text-sm text-slate-500">Type:</span>
                {% for t in ['all', 'livraison', 'à-emporter', 'sur-place'] %}
                    <button name="type" value="{{ t }}"
                            class="px-3 py-2 rounded-lg text-sm {{ typeFilter == t ? 'bg-emerald-500 text-white' : 'bg-slate-100 text-slate-700' }}">
                        {{ t == 'all' ? 'Tous' : t }}
                    </button>
                {% endfor %}
            </div>
        </div>
    </form>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="{{ path('orders_index', {status: 'en-cours'}) }}" class="block rounded-xl p-4 hover:shadow border {{ statusFilter == 'en-cours' ? 'bg-emerald-500 text-white border-emerald-500' : 'bg-white border-slate-200' }}">
            <p class="text-sm mb-1 {{ statusFilter == 'en-cours' ? 'text-white/90' : 'text-slate-500' }}">En cours</p>
            <p class="text-2xl font-semibold">{{ stats['en-cours'] ?? 0 }}</p>
        </a>
        <a href="{{ path('orders_index', {status: 'validée'}) }}" class="block rounded-xl p-4 hover:shadow border {{ statusFilter == 'validée' ? 'bg-emerald-500 text-white border-emerald-500' : 'bg-white border-slate-200' }}">
            <p class="text-sm mb-1 {{ statusFilter == 'validée' ? 'text-white/90' : 'text-slate-500' }}">Validées</p>
            <p class="text-2xl font-semibold">{{ stats['validée'] ?? 0 }}</p>
        </a>
        <a href="{{ path('orders_index', {status: 'terminée'}) }}" class="block rounded-xl p-4 hover:shadow border {{ statusFilter == 'terminée' ? 'bg-emerald-500 text-white border-emerald-500' : 'bg-white border-slate-200' }}">
            <p class="text-sm mb-1 {{ statusFilter == 'terminée' ? 'text-white/90' : 'text-slate-500' }}">Terminées</p>
            <p class="text-2xl font-semibold">{{ stats['terminée'] ?? 0 }}</p>
        </a>
        <a href="{{ path('orders_index', {status: 'annulée'}) }}" class="block rounded-xl p-4 hover:shadow border {{ statusFilter == 'annulée' ? 'bg-emerald-500 text-white border-emerald-500' : 'bg-white border-slate-200' }}">
            <p class="text-sm mb-1 {{ statusFilter == 'annulée' ? 'text-white/90' : 'text-slate-500' }}">Annulées</p>
            <p class="text-2xl font-semibold">{{ stats['annulée'] ?? 0 }}</p>
        </a>
    </div>

    <div class="space-y-4">
        {% for order in orders %}
            {# normalize status to handle variants like EN_COURS vs en-cours #}
            {% set s = order.status|lower|replace({'_':'-'}) %}
            <div class="bg-white border border-slate-200 rounded-xl p-6 hover:shadow-lg transition">
                <div class="flex items-start justify-between mb-4">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 bg-emerald-50 rounded-xl flex items-center justify-center text-xl">
                            {% if order.type == 'livraison' %}🚚{% elseif order.type == 'à-emporter' %}🛍️{% else %}🍽️{% endif %}
                        </div>
                        <div>
                            <div class="flex flex-wrap items-center gap-3 mb-1">
                                <h3 class="font-semibold">Commande #{{ order.id }}</h3>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs
                                    {% if s == 'en-cours' %}bg-amber-100 text-amber-700
                                    {% elseif s == 'validée' %}bg-sky-100 text-sky-700
                                    {% elseif s == 'terminée' %}bg-emerald-100 text-emerald-700
                                    {% else %}bg-red-100 text-red-700{% endif %}">
                                    {{ order.status }}
                                </span>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-slate-100 text-slate-700 capitalize">
                                    {{ order.type }}
                                </span>
                            </div>
                            <div class="flex flex-wrap gap-4 text-sm text-slate-600">
                                <span>👤 {{ order.customer.name }}</span>
                                <span>📅 {{ order.createdAt|date('d/m/Y H:i') }}</span>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-sky-50 text-sky-700">
                                    {{ order.paymentMethod }}
                                </span>
                            </div>
                            {% if order.type == 'livraison' and order.address %}
                                <div class="mt-2 text-sm text-slate-600 flex items-start gap-2">
                                    <span>📍</span>
                                    <span>
                                        {{ order.address }}
                                        {% if order.zone %} ({{ order.zone.name }}){% endif %}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-2xl font-semibold text-emerald-600 mb-1">
                            {{ order.total|number_format(0, '', ' ') }} FCFA
                        </p>
                        {% if order.deliveryPerson %}
                            <span class="inline-flex items-center px-3 py-1 rounded-full text-xs bg-emerald-100 text-emerald-700">
                                🚚 {{ order.deliveryPerson }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                <div class="mb-4 p-4 bg-slate-50 rounded-lg">
                    <h4 class="mb-2 text-sm font-medium text-slate-700">Articles</h4>
                    <div class="grid md:grid-cols-2 gap-1 text-sm">
                        {% for item in order.items %}
                            <div class="flex justify-between">
                                <span>{{ item.quantity }}x {{ item.name }}</span>
                                <span class="text-slate-500">
                                    {{ (item.price * item.quantity)|number_format(0, '', ' ') }} FCFA
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="flex flex-wrap gap-2">
                    {% if s == 'en-cours' %}
                        <form method="post" action="{{ path('orders_update_status', {id: order.id}) }}">
                            <input type="hidden" name="status" value="validée">
                            <button type="submit" class="px-4 py-2 rounded-lg text-sm bg-emerald-500 text-white flex items-center gap-2">
                                ✅ Valider
                            </button>
                        </form>
                        <form method="post" action="{{ path('orders_update_status', {id: order.id}) }}">
                            <input type="hidden" name="status" value="annulée">
                            <button type="submit" class="px-4 py-2 rounded-lg text-sm bg-red-500 text-white flex items-center gap-2">
                                ❌ Annuler
                            </button>
                        </form>
                    {% elseif s == 'validée' %}
                        {# For validated orders: if delivery type require an assigned livreur before completing #}
                        {% if order.type == 'livraison' %}
                            {% if order.deliveryPerson %}
                                <form method="post" action="{{ path('orders_update_status', {id: order.id}) }}">
                                    <input type="hidden" name="status" value="terminée">
                                    <button type="submit" class="px-4 py-2 rounded-lg text-sm bg-emerald-500 text-white flex items-center gap-2">
                                        📦 Marquer terminée
                                    </button>
                                </form>
                            {% else %}
                                <span class="text-sm text-slate-500">Veuillez assigner un livreur pour terminer cette commande.</span>
                            {% endif %}
                        {% else %}
                            <form method="post" action="{{ path('orders_update_status', {id: order.id}) }}">
                                <input type="hidden" name="status" value="terminée">
                                <button type="submit" class="px-4 py-2 rounded-lg text-sm bg-emerald-500 text-white flex items-center gap-2">
                                    📦 Marquer terminée
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}

                    {% if order.type == 'livraison' and not order.deliveryPerson %}
                        <form method="post" action="{{ path('orders_assign_delivery', {id: order.id}) }}" class="flex gap-2 items-center">
                            <select name="deliveryPerson" required class="px-3 py-2 rounded-lg border border-slate-200 bg-white text-sm">
                                <option value="">Choisir un livreur...</option>
                                {% for l in livreurs %}
                                    <option value="{{ l.id }}">{{ l.prenom }} {{ l.nom }} — {{ l.telephone }}</option>
                                {% endfor %}
                            </select>
                            <button type="submit" class="px-4 py-2 rounded-lg text-sm bg-slate-900 text-white flex items-center gap-2">
                                🚚 Assigner
                            </button>
                        </form>
                    {% endif %}

                    {# no direct complete for non-validated orders; completion is only allowed when status == 'validée' #}
                </div>
            </div>
        {% else %}
            <div class="text-center py-20">
                <div class="text-6xl mb-4">📦</div>
                <h2 class="text-lg font-semibold mb-1">Aucune commande trouvée</h2>
                <p class="text-slate-500">Essayez de modifier vos filtres</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}


